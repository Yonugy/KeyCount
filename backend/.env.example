# Copy this file to .env and fill in real values, or export these as
# environment variables before running the server.

# Postgres connection string. Format:
#   postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
DATABASE_URL=postgres://keycount:keycount@localhost:5432/keycount?sslmode=disable

# Any long random string -- used to sign login JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional, defaults to :8080
ADDR=:8080

# Comma-separated list of frontend origins allowed to call this API from a
# browser (e.g. "http://localhost:5173,https://keycount.example.com").
# Optional, defaults to http://localhost:5173 (Vite's dev-server default)
# if unset. Added 2026-09-02 when this API started being reachable by
# other people's browsers, not just one developer's own localhost -- see
# the backend README's CORS section.
ALLOWED_ORIGINS=http://localhost:5173
